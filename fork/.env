# Data4Sec Elasticsearch settings required by the fork first increment
ELASTICSEARCH_WRITE_HOST=data4sec-api.fr.world.socgen
ELASTICSEARCH_WRITE_PORT=443
ELASTICSEARCH_WRITE_LOGIN=myfxxxxxxxxxxxxxxxxxxxxxxx
ELASTICSEARCH_WRITE_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the platform_accounts index/field names if Data4Sec changes.
# PLATFORM_ACCOUNTS_INDEX=platform_accounts
# PLATFORM_ACCOUNTS_TAGS_FIELD=tags
# PLATFORM_ACCOUNTS_KEAR_TAG_KEY=KEAR_SG_UID

# DALI settings required by the second increment (W02 DALI-only extract)
